{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The PRACTICE shop: exactly the same admin screens as the real admin (the same build, deployed a second time), but running on its own
  // small database full of pretend data (secret DATABASE_URL = the SANDBOX_DATABASE_URL GitHub secret). SANDBOX=1 switches on the daily
  // allowance of clicks, the limits on how much can be created, and blocks every outside service (email, WhatsApp, TCS, notifications).
  "name": "nure-asmir-sandbox",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Pictures are shared with the real shop (the practice shop can add pictures but never deletes one).
  "r2_buckets": [{ "binding": "MEDIA_R2", "bucket_name": "nure-asmir-media-r2" }],
  "vars": { "APP_TARGET": "admin", "SANDBOX": "1", "SANDBOX_HITS_PER_DAY": "1500" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "sandbox.nureasmir.com", "custom_domain": true }]
}
